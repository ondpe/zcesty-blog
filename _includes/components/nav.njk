{% set activeTrip = tag or (tags | primaryTrip) %}
<nav aria-label="Cesty">
  <ul>
    {% for trip in collections.tripList %}
      {% set years = collections[trip] | postYears %}
      <li>
        <a href="/tags/{{ trip | slug }}/"{% if activeTrip == trip %} aria-current="page"{% endif %}>{{ trip }}{% if years %} {{ years }}{% endif %}</a>
      </li>
    {% endfor %}
  </ul>
</nav>
