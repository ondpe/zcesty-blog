<section class="posts-list">
  {% for post in postlist %}
    {% set tripName = post.data.tags | primaryTrip %}
    {% set stats = post.templateContent | readingStats %}
    <article class="post-card{% if not post.data.hero %} post-card--no-image{% endif %}">
      {% if post.data.hero %}
        <div class="post-card-image">
          {% cardImage post.data.hero, "(max-width: 880px) 100vw, 260px", loop.index0 < 2 %}
        </div>
      {% endif %}

      <div class="post-card-body">
        <p class="post-date">
          <time datetime="{{ post.date | machineDate }}">{{ post.date | czDate }}</time>
          {% if showTripBadge and tripName %}
            <a class="post-trip-badge" href="/tags/{{ tripName | slug }}/">{{ tripName }}</a>
          {% endif %}
        </p>

        <h2>
          <a href="{{ post.url | url }}">
            {{ post.data.title or "Bez názvu" }}
          </a>
        </h2>

        {% if post.data.summary %}
          <p class="post-card-summary">{{ post.data.summary }}</p>
        {% endif %}

        {% if stats %}
          <p class="post-meta-stats">{{ stats }}</p>
        {% endif %}
      </div>
    </article>
  {% endfor %}
</section>
