<footer class="site-footer">
  <p>
    <a href="{{ '/' | url }}">{{ metadata.title }}</a>
    <span> · </span>
    <a href="#main-content">Zpět nahoru</a>
  </p>
</footer>
{% if section == "post" %}
  <script src="/static/vendor/baguetteBox.min.js" defer></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      if (window.baguetteBox) {
        baguetteBox.run(".gallery", {
          overlayBackgroundColor: "rgba(0, 0, 0, 0.85)"
        });
      }

      var toggle = document.querySelector(".trip-toggle-btn");
      var sidebar = document.querySelector("#trip-sidebar");
      if (toggle && sidebar) {
        toggle.addEventListener("click", function () {
          var expanded = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", String(!expanded));
          sidebar.classList.toggle("is-open", !expanded);
        });
      }
    });
  </script>
{% endif %}
